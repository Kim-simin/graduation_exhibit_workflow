{
  "name": "Graduation Exhibit Research & Crawl Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "grad-exhibit-research",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [1],
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "node-schedule-trigger",
      "name": "Schedule Trigger (Mon 09:00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 480]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3000/api/admin/research",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"university\": {{$json.body?.university || \"홍익대학교\"}},\n  \"department\": {{$json.body?.department || \"시각디자인과\"}},\n  \"year\": {{$json.body?.year || \"2025\"}},\n  \"target_url\": {{$json.body?.target_url || \"https://sidi.hongik.ac.kr\"}}\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "node-call-research-api",
      "name": "Call LangGraph Research Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [520, 380]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "value2": "SUCCESS"
            }
          ]
        }
      },
      "id": "node-check-status",
      "name": "Check Research Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [780, 380]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "workflow_status",
              "value": "RESEARCH_COMPLETED"
            },
            {
              "name": "result_summary",
              "value": "={{$json.message || 'Evidence collected and persisted successfully'}}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-success-output",
      "name": "Research Complete Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1040, 280]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "workflow_status",
              "value": "RESEARCH_FAILED"
            },
            {
              "name": "error_detail",
              "value": "={{$json.error || 'Crawl or validation failure'}}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-failure-output",
      "name": "Error Isolation Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1040, 480]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Call LangGraph Research Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule Trigger (Mon 09:00)": {
      "main": [
        [
          {
            "node": "Call LangGraph Research Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call LangGraph Research Pipeline": {
      "main": [
        [
          {
            "node": "Check Research Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Research Status": {
      "main": [
        [
          {
            "node": "Research Complete Output",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Failure Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
